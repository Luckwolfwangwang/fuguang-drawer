{
  "name": "fuguang-drawer",
  "productName": "浮光抽屉",
  "version": "1.0.0",
  "private": true,
  "description": "Fuguang Drawer - a glass drawer that organizes Windows desktop icons",
  "main": "src/main.js",
  "author": "Fuguang Drawer contributors",
  "license": "MIT",
  "keywords": [
    "windows",
    "desktop",
    "desktop-organizer",
    "electron",
    "glassmorphism",
    "coloros"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . \"浮光抽屉\" --platform=win32 --arch=x64 --out=release --overwrite --icon=assets/icon.ico --executable-name=FuguangDrawer --app-version=1.0.0 --ignore=\"^/tools($|/)\" --ignore=\"^/docs($|/)\" --ignore=\"^/README\\.md$\" --ignore=\"^/_probe($|/)\" --ignore=\"^/release($|/)\" --ignore=\"^/src/(mock-data\\.js|mock-wallpaper\\.jpg|test.*\\.html)$\" --ignore=\"^/(install|playwright-install|package)\\.log$\"",
    "icon": "python tools/make-icon.py"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "electron": "45.1.0"
  }
}
